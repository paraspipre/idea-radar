# Copy to .env (gitignored) and fill in what you have.
#
# NEVER put ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN here. With the default
# agent_sdk backend they would make the SDK bill the Anthropic API instead of
# your Claude subscription, and `radar` refuses to start if they are set.

# Optional: keep the SQLite DB outside OneDrive (cloud sync + SQLite = locks).
# python-dotenv expands ${VAR}.
# RADAR__APP__DATA_DIR=${LOCALAPPDATA}/idea-radar

# Source credentials (used from M2 on). All optional.
# GITHUB_TOKEN=
# STACKEXCHANGE_KEY=
# PRODUCTHUNT_TOKEN=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
