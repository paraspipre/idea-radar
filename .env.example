# Copy to .env (gitignored). Every value is optional; Idea Radar runs with none of them.
#
# NEVER put ANTHROPIC_API_KEY or ANTHROPIC_AUTH_TOKEN here. With the default agent_sdk
# backend they would bill the Anthropic API instead of your Claude Pro plan (which has no
# API credits), so radar refuses to start if they are set.

# Keep the SQLite DB outside OneDrive (cloud sync + SQLite = locks). python-dotenv expands ${VAR}.
# RADAR__APP__DATA_DIR=${LOCALAPPDATA}/idea-radar

# GitHub: raises the search rate limit. GitHub Issues works without it.
GITHUB_TOKEN=
# Stack Exchange: raises the daily quota from 300 to 10,000 requests. Works without it.
STACKEXCHANGE_KEY=
# Product Hunt: the source stays off until this is set.
PRODUCTHUNT_TOKEN=
# Reddit: the source stays off until both are set (new API access needs Reddit's approval).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
